{
  "engine": "google",
  "sourceLang": "auto",
  "targetLang": "zh-CN",
  "displayMode": "bilingual",
  "transStyle": "none",
  "transColor": "#8b5cf6",
  "floatBall": true,
  "selection": {
    "enabled": true,
    "trigger": "icon"
  },
  "hover": {
    "enabled": true,
    "key": "Alt"
  },
  "inputTranslate": {
    "enabled": false,
    "targetLang": "en"
  },
  "youtube": {
    "enabled": true
  },
  "alwaysSites": [
    "news.ycombinator.com",
    "medium.com"
  ],
  "neverSites": [
    "mail.google.com"
  ]
}
