# Edge Functions 的环境变量示例。复制为 supabase/functions/.env（已被 git 忽略）后填写；
# 部署到云端时用 `npx supabase secrets set --env-file supabase/functions/.env` 写入。
# 绝不要把真实密钥提交到仓库，也不要写进扩展代码。详见 docs/backend.md。

# ---------- Stripe（测试模式用 sk_test_ 开头的密钥） ----------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# 由 scripts/setup_stripe.py 创建后输出
STRIPE_PRICE_PREMIUM_YEARLY=
STRIPE_PRICE_PLUS_MONTHLY=
STRIPE_PRICE_PLUS_YEARLY=
STRIPE_PORTAL_CONFIGURATION=

# 支付完成后跳回的后端地址（本地为 http://127.0.0.1:54321，云端为 https://<项目 ref>.supabase.co）
PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# ---------- 翻译服务商（只填你要开放的引擎） ----------
DEEPL_API_KEY=
DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-flash
AZURE_TRANSLATOR_KEY=
AZURE_TRANSLATOR_REGION=
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1-mini
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-haiku-5-5

# ---------- 额度（可选，留空使用默认值；成本依据见 docs/backend.md 第十节） ----------
# POINT_LIMIT_MONTHLY=15000000
# CHAR_LIMIT_PREMIUM=100000
# CHAR_LIMIT_PLUS=200000
# 暂不开放的引擎，逗号分隔；设为空字符串表示全部开放
# DISABLED_ENGINES=openai,gemini
