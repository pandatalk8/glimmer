{
  "manifest_version": 3,
  "name": "微光翻译 Glimmer - 沉浸式双语翻译",
  "short_name": "Glimmer",
  "version": "0.2.0",
  "description": "沉浸式双语网页翻译、划词翻译、YouTube 双语字幕。支持 Google、Microsoft、DeepL、GPT、Gemini、DeepSeek、Claude 等引擎。",
  "minimum_chrome_version": "111",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "微光翻译",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "options_page": "options/options.html",
  "background": {
    "service_worker": "src/background/index.js",
    "type": "module"
  },
  "permissions": ["storage", "contextMenus", "activeTab", "scripting"],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content/content.js"],
      "css": ["src/content/content.css"],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": ["https://www.youtube.com/*", "https://m.youtube.com/*"],
      "js": ["src/content/yt-hook.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://www.youtube.com/*", "https://m.youtube.com/*"],
      "js": ["src/content/youtube.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["src/content/ui.css", "panel/*", "styles/*", "src/shared/*", "icons/*"],
      "matches": ["<all_urls>"]
    }
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Q" },
      "description": "打开 / 收起侧面板"
    },
    "toggle-translate": {
      "suggested_key": { "default": "Alt+A" },
      "description": "翻译 / 还原当前页面"
    },
    "toggle-display-mode": {
      "suggested_key": { "default": "Alt+S" },
      "description": "切换双语 / 仅译文"
    }
  }
}
